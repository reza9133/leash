# Copy to .env (or export these in the shell). `npm run keys` can create the file for you.
# Never commit real keys. In a GitHub Codespace, store them as Codespaces secrets with the same names.

# Required: two different accounts on Studionet. The owner needs roughly 0.3 GEN in total.
OWNER_KEY=0x
AGENT_KEY=0x

# Optional: a third account that watches approvals and posts challenge bonds (needs about 0.05 GEN).
# Without it the challenge scenario tries to fund a fresh account and is skipped when that fails.
WATCHER_KEY=0x

# Optional: a guardian account (a random one is used when empty) and a stranger (random when empty).
GUARDIAN_KEY=
OUTSIDER_KEY=

# Optional: use an existing deployment instead of deploying contracts/leash.py first.
LEASH_ADDRESS=

# Optional tuning
# EVIDENCE_URL=https://www.iana.org/help/example-domains
# REPORT_DIR=reports
